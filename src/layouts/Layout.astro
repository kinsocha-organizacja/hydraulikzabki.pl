---
import "../styles/global.css";
import site from "../config/site.json";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = site.noindex } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
const canonical = `${site.domain}${path || "/"}`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, noimageindex" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#b9dceb" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
